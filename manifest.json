{
  "schemaVersion": 1,
  "id": "io.github.fabiocuccaro.monitor-manager",
  "name": "Monitor Manager",
  "version": "0.3.0",
  "author": "Fabio Cuccaro",
  "license": "MIT",
  "description": "Visual multi-monitor layout manager: drag, snap, try live with auto-rollback, save to monitors.lua.",
  "kinds": [
    "panel",
    "bar-widget"
  ],
  "entryPoints": {
    "panel": "Panel.qml",
    "barWidget": "Widget.qml"
  },
  "barWidget": {
    "displayName": "Monitor Manager",
    "description": "Opens the Monitor Manager panel.",
    "category": "System",
    "allowMultiple": false,
    "defaultSection": "right"
  }
}
